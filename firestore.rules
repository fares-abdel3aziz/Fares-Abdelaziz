rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Zero-lookup Salon Owner verification (protects against email spoofing via email_verified == true
    // and avoids O(n) database get/exists calls inside list queries)
    function isSalonOwnerToken() {
      return isSignedIn() && (
        (
          'email' in request.auth.token &&
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true &&
          request.auth.token.email == 'fareselbialy1941@gmail.com'
        ) ||
        (
          'phone_number' in request.auth.token &&
          request.auth.token.phone_number in ['+201029898309', '+201020484470']
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: Appointment Shape & Bounds
    function isValidAppointmentShape(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
             data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 30 &&
             data.barberId is string && data.barberId.size() >= 1 && data.barberId.size() <= 40 &&
             data.barberId in ['mody', 'barber_2', 'barber_3'] &&
             data.barberName is string && data.barberName.size() >= 1 && data.barberName.size() <= 80 &&
             data.packageId is string && data.packageId.size() >= 1 && data.packageId.size() <= 64 &&
             data.packageTitle is string && data.packageTitle.size() >= 1 && data.packageTitle.size() <= 150 &&
             data.packageServices is string && data.packageServices.size() >= 1 && data.packageServices.size() <= 600 &&
             data.selectedHaircut is string && data.selectedHaircut.size() <= 200 &&
             data.appointmentDate is string && data.appointmentDate.size() >= 2 && data.appointmentDate.size() <= 80 &&
             data.appointmentTime is string && data.appointmentTime.size() >= 2 && data.appointmentTime.size() <= 40 &&
             (data.appointmentEpochMillis is int || data.appointmentEpochMillis is number) && data.appointmentEpochMillis > 0 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.status is string && data.status.size() >= 1 && data.status.size() <= 20 &&
             data.status in ['confirmed', 'completed', 'cancelled'] &&
             data.reminderScheduled is bool &&
             (!('rating' in data) || data.rating in [0, 1, 2, 3, 4, 5]) &&
             (!('feedbackComment' in data) || (data.feedbackComment is string && data.feedbackComment.size() <= 500)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function hasValidAppointmentCreateKeys(data) {
      return data.status == 'confirmed' &&
             (!('rating' in data) || data.rating == 0) &&
             (!('feedbackComment' in data) || data.feedbackComment == '') &&
             data.keys().hasAll([
               'userId', 'customerName', 'customerPhone',
               'barberId', 'barberName', 'packageId', 'packageTitle',
               'packageServices', 'selectedHaircut', 'appointmentDate',
               'appointmentTime', 'appointmentEpochMillis', 'notes',
               'status', 'reminderScheduled', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'customerName', 'customerPhone',
               'barberId', 'barberName', 'packageId', 'packageTitle',
               'packageServices', 'selectedHaircut', 'appointmentDate',
               'appointmentTime', 'appointmentEpochMillis', 'notes',
               'status', 'reminderScheduled', 'rating', 'feedbackComment',
               'createdAt', 'updatedAt'
             ]);
    }

    function isValidCustomerAppointmentMutation() {
      return (
        // Action 1: Status transition from confirmed to cancelled or completed
        (
          existing().status == 'confirmed' &&
          incoming().status in ['cancelled', 'completed'] &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reminderScheduled', 'updatedAt'])
        ) ||
        // Action 2: Reschedule or edit details while confirmed
        (
          existing().status == 'confirmed' &&
          incoming().status == 'confirmed' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'customerName', 'customerPhone', 'barberId', 'barberName',
            'packageId', 'packageTitle', 'packageServices', 'selectedHaircut',
            'appointmentDate', 'appointmentTime', 'appointmentEpochMillis',
            'notes', 'reminderScheduled', 'updatedAt'
          ])
        ) ||
        // Action 3: Submit or edit 1-5 star experience rating & feedback on a completed appointment
        (
          existing().status == 'completed' &&
          incoming().status == 'completed' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'feedbackComment', 'updatedAt']) &&
          ('rating' in incoming()) && incoming().rating in [1, 2, 3, 4, 5] &&
          ('feedbackComment' in incoming()) && incoming().feedbackComment is string && incoming().feedbackComment.size() <= 500
        )
      );
    }

    function isValidSalonOwnerStatusMutation() {
      return isSalonOwnerToken() &&
             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reminderScheduled', 'updatedAt']);
    }

    // Validation Blueprint: SalonPreference
    function isValidSalonPreference(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.savedCustomerName is string && data.savedCustomerName.size() <= 100 &&
             data.savedPhone is string && data.savedPhone.size() <= 30 &&
             data.barber2CustomName is string && data.barber2CustomName.size() <= 60 &&
             data.barber3CustomName is string && data.barber3CustomName.size() <= 60 &&
             data.salonWhatsappPhone is string && data.salonWhatsappPhone.size() >= 7 && data.salonWhatsappPhone.size() <= 30 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 1. User-Isolated Appointments Subcollection (PII-isolated per customer + Salon Owner status sync)
    match /users/{userId}/appointments/{appointmentId} {
      allow get: if isValidId(userId) && isValidId(appointmentId) && (isOwner(userId) || isSalonOwnerToken());
      allow list: if isOwner(userId) || isSalonOwnerToken();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(appointmentId) &&
                       isValidAppointmentShape(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       hasValidAppointmentCreateKeys(incoming());

      allow update: if isSignedIn() &&
                       isValidAppointmentShape(incoming()) &&
                       isValidId(userId) &&
                       isValidId(appointmentId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isValidSalonOwnerStatusMutation() ||
                         (isOwner(userId) && incoming().userId == request.auth.uid && isValidCustomerAppointmentMutation())
                       );

      allow delete: if isValidId(userId) && isValidId(appointmentId) && (isOwner(userId) || isSalonOwnerToken());
    }

    // 2. Central Salon Schedule Collection (Strictly Readable/Listable ONLY by Salon Owner or Record Creator)
    match /salon_bookings/{appointmentId} {
      allow get: if isValidId(appointmentId) && (
                   isSalonOwnerToken() ||
                   (isSignedIn() && existing().userId == request.auth.uid)
                 );

      allow list: if isSalonOwnerToken() ||
                    (isSignedIn() && existing().userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(appointmentId) &&
                       isValidAppointmentShape(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       hasValidAppointmentCreateKeys(incoming());

      allow update: if isSignedIn() &&
                       isValidAppointmentShape(incoming()) &&
                       isValidId(appointmentId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isValidSalonOwnerStatusMutation() ||
                         (existing().userId == request.auth.uid && isValidCustomerAppointmentMutation())
                       );

      allow delete: if isValidId(appointmentId) && (
                      isSalonOwnerToken() ||
                      (isSignedIn() && existing().userId == request.auth.uid)
                    );
    }

    // 3. User-Isolated Salon Preferences Subcollection
    match /users/{userId}/salon_preferences/{prefId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(prefId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(prefId) &&
                       isValidSalonPreference(incoming()) &&
                       incoming().keys().hasAll([
                         'userId', 'savedCustomerName', 'savedPhone',
                         'barber2CustomName', 'barber3CustomName',
                         'salonWhatsappPhone', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'savedCustomerName', 'savedPhone',
                         'barber2CustomName', 'barber3CustomName',
                         'salonWhatsappPhone', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidSalonPreference(incoming()) &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(prefId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'savedCustomerName', 'savedPhone',
                         'barber2CustomName', 'barber3CustomName',
                         'salonWhatsappPhone', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(prefId);
    }
  }
}
